 theory.","options":["has","have","is","was"],"correctIndex":1},{"number":32,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Choose the closest meaning of “obdurate”.","options":["Yielding","Stubborn","Careless","Timid"],"correctIndex":1},{"number":33,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Choose the antonym of “ephemeral”.","options":["Fleeting","Transient","Enduring","Momentary"],"correctIndex":2},{"number":34,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"No sooner ______ the announcement than the crowd cheered.","options":["he made","had he made","he had made","did he made"],"correctIndex":1},{"number":35,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Choose the correctly punctuated sentence.","options":["Its a difficult decision, isnt it?","It’s a difficult decision, isn’t it?","Its a difficult decision; isn’t it.","It’s a difficult decision isn’t it."],"correctIndex":1},{"number":36,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"The committee arrived ______ a unanimous decision.","options":["to","at","on","for"],"correctIndex":1},{"number":37,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"He would rather you ______ the truth now.","options":["tell","told","will tell","have told"],"correctIndex":1},{"number":38,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Select the correctly spelled word.","options":["Acquiescence","Acquiesence","Acquiescense","Aquescence"],"correctIndex":0},{"number":39,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"The proposal was rejected because it was ______ with the existing policy.","options":["consistent","incompatible","congruent","consonant"],"correctIndex":1},{"number":40,"section":"English Language","contextText":nu