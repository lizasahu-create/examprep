{"id":"odia_eng_prob_set_05","title":"English & Odia Mock — Probable Set 5","questions":[{"number":1,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Choose the part of speech of “drawing” in: A drowning man catches at a straw.","options":["Complement","Infinitive","Gerund","Participle"],"correctIndex":3},{"number":2,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Choose the part of speech of “liar” in: A great talker is a great liar.","options":["Article","Verb","Pronoun","Noun"],"correctIndex":3},{"number":3,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Choose the part of speech of “to live” in: Eat to live, but do not live to eat.","options":["Complement","Infinitive","Gerund","Participle"],"correctIndex":1},{"number":4,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Everyone at the party ______ amazed by his performance.","options":["was","were","are","can"],"correctIndex":0},{"number":5,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Alice is not at home at the moment. She ______ work.","options":["was on","was at","is on","is at"],"correctIndex":3},{"number":6,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"French people love cooking, ______ the English don’t seem very interested.","options":["when","whenever","where","whereas"],"correctIndex":3},{"number":7,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Wait a minute, I ______ this box for you.","options":["carry","will carry","carried","was carrying"],"correctIndex":1},{"number":8,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"It’s wet and rainy outside today. You ______ go out without an umbrella.","options":["shouldn’t","won’t","don’t have to","should"],"correctIndex":0},{"number":9,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Change into passive: The salt-water corroded the metal beams. The metal beams ______ by the salt-water.","options":["was corroded","corroded","has corroded","were corroded"],"correctIndex":3},{"number":10,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"A bomb scare ______ a delay of the flight.","options":["causing","cause","was caused","had caused"],"correctIndex":3},{"number":11,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Had the instructions been clearer, fewer errors ______.","options":["would occur","would have occurred","had occurred","will occur"],"correctIndex":1},{"number":12,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Choose the antonym of “equivocal”.","options":["Ambiguous","Unambiguous","Dubious","Evasive"],"correctIndex":1},{"number":13,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"The report is replete ______ factual inconsistencies.","options":["of","by","with","in"],"correctIndex":2},{"number":14,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"The judge ordered that the documents ______ sealed.","options":["are","were","be","have"],"correctIndex":2},{"number":15,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Select the correct sentence.","options":["Rarely we have seen such precision.","Rarely have we seen such precision.","Rarely we saw such precision.","Rarely did we have saw such precision."],"correctIndex":1},{"number":16,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Choose the synonym of “pellucid”.","options":["Opaque","Lucid","Confused","Tedious"],"correctIndex":1},{"number":17,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"He was prevented ______ entering the restric