{"id":"odia_eng_prob_set_07","title":"English & Odia Mock — Probable Set 7","questions":[{"number":1,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Change into passive voice: I will clean the house every Saturday.","options":["The house cleaned every Saturday.","The house will cleaned every Saturday.","The house will be cleaned every Saturday.","The house has been cleaned every Saturday."],"correctIndex":2},{"number":2,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"People ______ walk on grass.","options":["couldn’t","needn’t","mustn’t","may not"],"correctIndex":2},{"number":3,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Choose the correct word order.","options":["Why she did leave so early?","Why did she leave so early?","Why did so early she leave?","Why so early did she leave?"],"correctIndex":1},{"number":4,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Choose the word nearest in meaning to “scalded”.","options":["Burnt by hot liquid or steam","Bruised","Cut","Frozen"],"correctIndex":0},{"number":5,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"______ his principles, he has to be very careful.","options":["With regard of","With regard on","With regard to","With regard for"],"correctIndex":2},{"number":6,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"He was seen ______ to the school.","options":["went","going","gone","go"],"correctIndex":1},{"number":7,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"“The Raos had been living frugally all year.” Identify the tense.","options":["Present perfect continuous","Past perfect continuous","Simple past","Past continuous"],"correctIndex":1},{"number":8,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Improve: They could not admire his performance because of they dislike him.","options":["because of they disliked him","because they dislike him","because of dislike him","No improvement"],"correctIndex":1},{"number":9,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"She was uneasy because she ______ on a plane before.","options":["has never been","had never been","never was","was never being"],"correctIndex":1},{"number":10,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Choose the correct form: Neither of the two answers ______ correct.","options":["are","were","is","have been"],"correctIndex":2},{"number":11,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Hardly had the lecture begun ______ the lights went out.","options":["than","when","then","that"],"correctIndex":1},{"number":12,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"Choose the correctly punctuated sentence.","options":["Its a difficult task, isnt it?","It’s a difficult task, isn’t it?","Its a difficult task, isn’t it?","It’s a difficult task isn’t it."],"correctIndex":1},{"number":13,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"The committee ______ divided in its opinions. (Emphasise individual members.)","options":["is","are","has","was"],"correctIndex":1},{"number":14,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"The word “obdurate” is closest in meaning to:","options":["pliant","stubborn","generous","timid"],"correctIndex":1},{"number":15,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"The antonym of “ephemeral” is:","options":["fleeting","transient","permanent","brief"],"correctIndex":2},{"number":16,"section":"English Language","contextText":null,"imageAssetPath":null,"questionText":"He insisted ______ paying the entire bill.","options":["for","at",